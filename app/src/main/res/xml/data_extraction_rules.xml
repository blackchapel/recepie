<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (targetSdk 31+): what a backup or a phone-to-phone transfer
    may copy. allowBackup="false" turns off cloud backup only; a device
    transfer still copies the app's files unless these rules say otherwise.

    The recipes, photos and settings move to a new phone, but not the Google
    Drive backup status: it says "connected" and "automatic backups
    scheduled", while the new phone has neither the schedule (WorkManager's
    database is not transferred) nor a Google authorization. Left out, the
    Backup page starts as "not connected" and the user connects once.
-->
<data-extraction-rules>
    <!-- Cloud backup stays off (allowBackup="false"); say so here too. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backup-status.json" />
        <exclude domain="file" path="backup-status.json.tmp" />
    </device-transfer>
</data-extraction-rules>
